<!DOCTYPE html>
<html lang="en">
    <head>
        <title><%= title %></title>
        <link rel="icon" type="image/x-icon" href="./img/favicon.ico" />
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, shrink-to-fit=no"
        />
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
            crossorigin="anonymous"
        />
        <link rel="stylesheet" href="/css/style.css" />
        <link
            rel="stylesheet"
            href="https://cdn.datatables.net/2.1.8/css/dataTables.dataTables.css"
        />
        <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
        <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
        <script
            type="text/javascript"
            src="https://www.gstatic.com/charts/loader.js"
        ></script>
        <script type="text/javascript">
            google.charts.load("current", { packages: ["corechart"] });
            google.charts.setOnLoadCallback(drawChart1);
            google.charts.setOnLoadCallback(drawChart2);
            google.charts.setOnLoadCallback(drawChart3);

            function drawChart1() {
                fetch("http://localhost:3000/api/genderBySickid")
                    .then((response) => response.json())
                    .then((data) => {
                        const chartData = [["Cinsiyet", "Yüzde"]]; // Başlık ekleniyor

                        // API'den dönen verileri formatlayarak chartData'ya ekliyoruz
                        data.genderBySickid.forEach((item) => {
                            chartData.push([item.gender_name, item.number]);
                        });

                        // Google Charts veri formatına dönüştürülüyor
                        const dataTable =
                            google.visualization.arrayToDataTable(chartData);

                        const options = {
                            title: "Muayene Edilen Hastaların Cinsiyet Dağılımı (Muayene ID Bazlı)",
                            titleTextStyle: {
                                fontSize: 18,
                                bold: true,
                            },
                            chartArea: {
                                top: 85, // Üst padding
                            },
                        };

                        const chart = new google.visualization.PieChart(
                            document.getElementById("piechart1")
                        );

                        chart.draw(dataTable, options);
                    })
                    .catch((error) => {
                        console.error(
                            "API çağrısı sırasında bir hata oluştu:",
                            error
                        );
                    });
            }

            function drawChart2() {
                fetch("http://localhost:3000/api/genderByTcno")
                    .then((response) => response.json())
                    .then((data) => {
                        const chartData = [["Cinsiyet", "Yüzde"]]; // Başlık ekleniyor

                        // API'den dönen verileri formatlayarak chartData'ya ekliyoruz
                        data.genderByTcno.forEach((item) => {
                            chartData.push([item.gender_name, item.number]);
                        });

                        // Google Charts veri formatına dönüştürülüyor
                        const dataTable =
                            google.visualization.arrayToDataTable(chartData);

                        const options = {
                            title: "Muayene Edilen Hastaların Cinsiyet Dağılımı (TC No Bazlı)",
                            titleTextStyle: {
                                fontSize: 18,
                                bold: true,
                            },
                            chartArea: {
                                top: 85, // Üst padding
                            },
                        };

                        const chart = new google.visualization.PieChart(
                            document.getElementById("piechart2")
                        );

                        chart.draw(dataTable, options);
                    })
                    .catch((error) => {
                        console.error(
                            "API çağrısı sırasında bir hata oluştu:",
                            error
                        );
                    });
            }

            function drawChart3() {
                fetch("http://localhost:3000/api/numberOfSickByDepartment")
                    .then((response) => response.json())
                    .then((data) => {
                        const chartData = [["Departman Adı", "Muayene Sayısı"]]; // Başlık ekleniyor

                        // API'den dönen verileri formatlayarak chartData'ya ekliyoruz
                        data.numberOfSickByDepartment.forEach((item) => {
                            chartData.push([item.department_name, item.number]);
                        });

                        // Google Charts veri formatına dönüştürülüyor
                        const dataTable =
                            google.visualization.arrayToDataTable(chartData);

                        const options = {
                            title: "Hastaların Muayene Oldukları Departman Dağılımları",
                            titleTextStyle: {
                                fontSize: 18,
                                bold: true,
                            },
                            chartArea: {
                                top: 85, // Üst padding
                            },
                        };

                        const chart = new google.visualization.PieChart(
                            document.getElementById("piechart3")
                        );

                        chart.draw(dataTable, options);
                    })
                    .catch((error) => {
                        console.error(
                            "API çağrısı sırasında bir hata oluştu:",
                            error
                        );
                    });
            }
        </script>
    </head>
    <body>
        <%- include('../_partials/_navbar') %>
        <div class="container-fluid px-5">
            <div
                class="row bg-success-subtle"
                style="min-height: 100vh; height: 100%"
            >
                <div class="col-md-12 py-3 px-4 d-flex justify-content-center">
                    <div class="col-md-6 p-3 mx-1 tablebgcolor">
                        <h5 class="text-center">Hasta Bilgileri</h5>
                        <div>
                            <table
                                id="table_sick"
                                class="display rounded"
                                style="
                                    width: 100%;
                                    background-color: whitesmoke;
                                "
                            >
                                <thead>
                                    <tr>
                                        <th class="text-center">TC No</th>
                                        <th>Hasta</th>
                                        <th>Doktor</th>
                                        <th>Departman</th>
                                        <th class="text-center">
                                            Muayene Tarihi
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- prettier-ignore -->
                                    <% list_sick.forEach(item => { %>
                                    <!-- prettier-ignore -->
                                    <tr>
                                        <td class="text-center"><%= item.sick_tc_no %></td>
                                        <td><%= `${item.sick_name} ${item.sick_surname}` %></td>
                                        <td><%= `${item.doctor_name} ${item.doctor_surname}` %></td>
                                        <td><%= item.department_name %></td>
                                        <td class="text-center"><%= new Intl.DateTimeFormat("tr-TR", { day: "numeric", month: "short", year: "numeric" }).format(new Date(item.sick_registration_date)) %></td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-6 p-3 mx-1">
                        <div
                            class="col-md-12"
                            style="min-height: 20vh; translate: 0px -15px"
                        >
                            <div
                                id="piechart3"
                                style="min-width: 100%; height: 300px"
                            ></div>
                        </div>
                        <hr style="translate: 0px -15px" />

                        <div
                            class="col-md-12"
                            style="min-height: 20vh; translate: 0px -15px"
                        >
                            <div
                                id="piechart1"
                                style="min-width: 100%; height: 300px"
                            ></div>
                        </div>
                        <hr style="translate: 0px -15px" />
                        <div
                            class="col-md-12"
                            style="min-height: 20vh; translate: 0px -15px"
                        >
                            <div
                                id="piechart2"
                                style="min-width: 100%; height: 300px"
                            ></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script
            src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
            integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
            crossorigin="anonymous"
        ></script>

        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"
            integrity="sha384-BBtl+eGJRgqQAUMxJ7pMwbEyER4l1g+O15P+16Ep7Q9Q+zqX6gSbd85u4mG4QzX+"
            crossorigin="anonymous"
        ></script>
        <script>
            new DataTable("#table_sick", {
                paging: false,
                scrollCollapse: true,
                scrollY: "75vh",
                order: [[4, "desc"]],
            });
        </script>
    </body>
</html>
