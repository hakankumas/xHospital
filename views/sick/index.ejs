<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <meta name="theme-name" content="quixlab" />
        <title><%= title %></title>
        <link rel="icon" type="image/x-icon" href="./img/favicon.ico" />
        <link
            href="theme/plugins/pg-calendar/css/pignose.calendar.min.css"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="theme/plugins/chartist/css/chartist.min.css"
        />
        <link
            rel="stylesheet"
            href="theme/plugins/chartist-plugin-tooltips/css/chartist-plugin-tooltip.css"
        />
        <link href="theme/css/style.css" rel="stylesheet" />
        <link
            rel="stylesheet"
            href="https://cdn.datatables.net/2.1.8/css/dataTables.dataTables.css"
        />
        <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
        <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
        <script
            type="text/javascript"
            src="https://www.gstatic.com/charts/loader.js"
        ></script>
        <script type="text/javascript">
            google.charts.load("current", { packages: ["corechart"] });
            google.charts.setOnLoadCallback(drawChart1);
            google.charts.setOnLoadCallback(drawChart2);
            google.charts.setOnLoadCallback(drawChart3);

            function drawChart1() {
                fetch("http://localhost:3000/api/genderBySickid")
                    .then((response) => response.json())
                    .then((data) => {
                        const chartData = [["Cinsiyet", "Yüzde"]];

                        data.genderBySickid.forEach((item) => {
                            chartData.push([item.gender_name, item.number]);
                        });

                        const dataTable =
                            google.visualization.arrayToDataTable(chartData);

                        const options = {
                            title: "Muayene Edilen Hastaların Cinsiyet Dağılımı (Muayene ID Bazlı)",
                            titleTextStyle: {
                                fontSize: 18,
                                bold: true,
                            },
                            chartArea: {
                                top: 85,
                            },
                        };

                        const chart = new google.visualization.PieChart(
                            document.getElementById("piechart1")
                        );

                        chart.draw(dataTable, options);
                    })
                    .catch((error) => {
                        console.error(
                            "API çağrısı sırasında bir hata oluştu:",
                            error
                        );
                    });
            }

            function drawChart2() {
                fetch("http://localhost:3000/api/genderByTcno")
                    .then((response) => response.json())
                    .then((data) => {
                        const chartData = [["Cinsiyet", "Yüzde"]];

                        data.genderByTcno.forEach((item) => {
                            chartData.push([item.gender_name, item.number]);
                        });

                        const dataTable =
                            google.visualization.arrayToDataTable(chartData);

                        const options = {
                            title: "Muayene Edilen Hastaların Cinsiyet Dağılımı (TC No Bazlı)",
                            titleTextStyle: {
                                fontSize: 18,
                                bold: true,
                            },
                            chartArea: {
                                top: 85,
                            },
                        };

                        const chart = new google.visualization.PieChart(
                            document.getElementById("piechart2")
                        );

                        chart.draw(dataTable, options);
                    })
                    .catch((error) => {
                        console.error(
                            "API çağrısı sırasında bir hata oluştu:",
                            error
                        );
                    });
            }

            function drawChart3() {
                fetch("http://localhost:3000/api/numberOfSickByDepartment")
                    .then((response) => response.json())
                    .then((data) => {
                        const chartData = [["Departman Adı", "Muayene Sayısı"]];

                        data.numberOfSickByDepartment.forEach((item) => {
                            chartData.push([item.department_name, item.number]);
                        });

                        const dataTable =
                            google.visualization.arrayToDataTable(chartData);

                        const options = {
                            title: "Hastaların Muayene Oldukları Departman Dağılımları",
                            titleTextStyle: {
                                fontSize: 18,
                                bold: true,
                            },
                            chartArea: {
                                top: 85,
                            },
                        };

                        const chart = new google.visualization.PieChart(
                            document.getElementById("piechart3")
                        );

                        chart.draw(dataTable, options);
                    })
                    .catch((error) => {
                        console.error(
                            "API çağrısı sırasında bir hata oluştu:",
                            error
                        );
                    });
            }
        </script>
    </head>

    <body>
        <%- include('../_partials/_preloader.ejs') %>
        <div id="main-wrapper">
            <%- include('../_partials/_logo.ejs') %> <%-
            include('../_partials/_header.ejs') %> <%-
            include('../_partials/_sidebar.ejs') %>
            <div class="content-body">
                <div class="container-fluid mt-3">
                    <div class="row">
                        <div class="col-12 col-lg-6">
                            <div class="card">
                                <div class="card-body">
                                    <h1
                                        class="text-center"
                                        style="font-size: 24px"
                                    >
                                        Hasta Bilgileri
                                    </h1>
                                    <div>
                                        <table
                                            id="table_sick"
                                            class="display rounded"
                                            style="
                                                width: 100%;
                                                background-color: whitesmoke;
                                            "
                                        >
                                            <thead>
                                                <tr>
                                                    <th class="text-center">
                                                        TC No
                                                    </th>
                                                    <th>Hasta</th>
                                                    <th>Doktor</th>
                                                    <th>Departman</th>
                                                    <th class="text-center">
                                                        Muayene Tarihi
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- prettier-ignore -->
                                                <% list_sick.forEach(item => { %>
                                                <!-- prettier-ignore -->
                                                <tr>
                                                    <td class="text-center"><%= item.sick_tc_no %></td>
                                                    <td><%= `${item.sick_name} ${item.sick_surname}` %></td>
                                                    <td><%= `${item.doctor_name} ${item.doctor_surname}` %></td>
                                                    <td><%= item.department_name %></td>
                                                    <td class="text-center"><%= new Intl.DateTimeFormat("tr-TR", { day: "numeric", month: "short", year: "numeric" }).format(new Date(item.sick_registration_date)) %></td>
                                                </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6">
                            <div class="card">
                                <div class="card-body">
                                    <div
                                        class="col-md-12"
                                        style="
                                            min-height: 20vh;
                                            translate: 0px -15px;
                                        "
                                    >
                                        <div
                                            id="piechart3"
                                            style="
                                                min-width: 100%;
                                                height: 300px;
                                            "
                                        ></div>
                                    </div>
                                </div>
                            </div>

                            <div class="card">
                                <div class="card-body">
                                    <div
                                        class="col-md-12"
                                        style="
                                            min-height: 20vh;
                                            translate: 0px -15px;
                                        "
                                    >
                                        <div
                                            id="piechart1"
                                            style="
                                                min-width: 100%;
                                                height: 300px;
                                            "
                                        ></div>
                                    </div>
                                </div>
                            </div>

                            <div class="card">
                                <div class="card-body">
                                    <div
                                        class="col-md-12"
                                        style="
                                            min-height: 20vh;
                                            translate: 0px -15px;
                                        "
                                    >
                                        <div
                                            id="piechart2"
                                            style="
                                                min-width: 100%;
                                                height: 300px;
                                            "
                                        ></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script src="theme/plugins/common/common.min.js"></script>
        <script src="theme/js/custom.min.js"></script>
        <script src="theme/js/settings.js"></script>
        <script src="theme/js/gleek.js"></script>
        <script src="theme/js/styleSwitcher.js"></script>
        <script src="theme/plugins/chart.js/Chart.bundle.min.js"></script>
        <script src="theme/plugins/circle-progress/circle-progress.min.js"></script>
        <script src="theme/plugins/d3v3/index.js"></script>
        <script src="theme/plugins/topojson/topojson.min.js"></script>
        <script src="theme/plugins/datamaps/datamaps.world.min.js"></script>
        <script src="theme/plugins/raphael/raphael.min.js"></script>
        <script src="theme/plugins/morris/morris.min.js"></script>
        <script src="theme/plugins/moment/moment.min.js"></script>
        <script src="theme/plugins/pg-calendar/js/pignose.calendar.min.js"></script>
        <script src="theme/plugins/chartist/js/chartist.min.js"></script>
        <script src="theme/plugins/chartist-plugin-tooltips/js/chartist-plugin-tooltip.min.js"></script>
        <script src="theme/js/dashboard/dashboard-1.js"></script>
        <script>
            new DataTable("#table_sick", {
                paging: false,
                scrollCollapse: true,
                scrollY: "100vh",
                order: [[4, "desc"]],
            });
        </script>
    </body>
</html>
