<% const baseURL = "http://localhost:3000"; %>

<!DOCTYPE html>
<html lang="en">
    <head>
        <title><%= title %></title>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, shrink-to-fit=no"
        />
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
            crossorigin="anonymous"
        />
        <link rel="stylesheet" href="/css/style.css" />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css"
            integrity="sha512-5Hs3dF2AEPkpNAR7UiOHba+lRSJNeM2ECkwxUIxC1Q/FLycGTbNapWXB4tP889k5T5Ju8fs4b1P5z/iB4nMfSQ=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"
        />
        <link
            rel="stylesheet"
            href="https://cdn.datatables.net/2.1.8/css/dataTables.dataTables.css"
        />
        <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
        <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
        <script
            type="text/javascript"
            src="https://www.gstatic.com/charts/loader.js"
        ></script>
        <script type="text/javascript">
            google.charts.load("current", { packages: ["corechart", "line"] });
            google.charts.setOnLoadCallback(drawBasic);

            function drawBasic() {
                fetch("http://localhost:3000/api/dailySickAmount")
                    .then((response) => {
                        if (!response.ok) {
                            throw new Error("Network response was not ok");
                        }
                        return response.json();
                    })
                    .then((data) => {
                        var chartData = new google.visualization.DataTable();
                        chartData.addColumn("string", "Günler");
                        chartData.addColumn("number", "Hasta Sayısı");
                        data.dailySickAmount.forEach((item) => {
                            chartData.addRow([
                                new Intl.DateTimeFormat("tr-TR", {
                                    day: "numeric",
                                    month: "short",
                                    year: "numeric",
                                }).format(
                                    new Date(item.doctor_sick_registration_date)
                                ),
                                item.number,
                            ]);
                        });
                        var options = {
                            title: "Günlük Hasta Sayıları",
                            titleTextStyle: {
                                fontSize: 24,
                                bold: true,
                            },
                            // curveType: "function",
                            // legend: { position: "bottom" },
                            hAxis: {
                                title: "Günler",
                                format: "M/d/yy",
                                slantedText: true,
                                slantedTextAngle: 90,
                            },
                            vAxis: {
                                title: "Hasta Sayısı",
                            },
                            chartArea: {
                                top: 75, // Üst padding
                                right: 200, // Sağ padding
                                bottom: 175, // Alt padding
                                left: 200, // Sol padding
                            },
                        };

                        var chart = new google.visualization.LineChart(
                            document.getElementById("chart_dailySickAmount")
                        );
                        chart.draw(chartData, options);
                    })
                    .catch((error) => {
                        console.error("Error fetching data:", error);
                        alert(
                            "Veri alınırken bir hata oluştu. Lütfen tekrar deneyin."
                        );
                    });
            }
        </script>
    </head>
    <body>
        <%- include('./_partials/_navbar.ejs') %>
        <div class="container-fluid px-5">
            <div
                class="bg-success-subtle"
                style="min-height: 100vh; height: 100%"
            >
                <div
                    class="col-md-12 pt-2 d-flex justify-content-center align-items-center"
                >
                    <div
                        id="chart_dailySickAmount"
                        style="width: 90%; height: 400px"
                    ></div>
                </div>
                <div
                    class="col-md-12 p-5 d-flex justify-content-center align-items-center gap-4"
                >
                    <div
                        class="col-md-4 d-flex justify-content-center align-items-center border border-dark rounded py-3 shadow-lg bg-info-subtle"
                    >
                        <a
                            href="<%= baseURL %>/department"
                            style="text-decoration: none; color: black"
                            class="px-5"
                        >
                            <div class="text-center">
                                <h3>Departman</h3>
                                <h5>(<%= count_department[0].number %>)</h5>
                            </div>
                        </a>
                    </div>
                    <div
                        class="col-md-4 d-flex justify-content-center align-items-center border border-dark rounded py-3 shadow-lg bg-info-subtle"
                    >
                        <a
                            href="<%= baseURL %>/doctor"
                            style="text-decoration: none; color: black"
                            class="px-5"
                        >
                            <div class="text-center">
                                <h3>Doktor</h3>
                                <h5>(<%= count_doctor[0].number %>)</h5>
                            </div>
                        </a>
                    </div>
                    <div
                        class="col-md-4 d-flex justify-content-center align-items-center border border-dark rounded py-3 shadow-lg bg-info-subtle"
                    >
                        <a
                            href="<%= baseURL %>/sick"
                            style="text-decoration: none; color: black"
                            class="px-5"
                        >
                            <div class="text-center">
                                <h3>Hasta</h3>
                                <h5>(<%= count_sick[0].number %>)</h5>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="col-md-12 py-3 px-4 d-flex justify-content-center">
                    <div class="col-md-4 border rounded border-dark p-3 mx-1">
                        <a
                            href="<%= baseURL %>/department"
                            style="text-decoration: none; color: black"
                        >
                            <h5 class="text-center">
                                Departmanlarımızın Bilgileri
                            </h5>
                        </a>
                        <div>
                            <table
                                id="table_department"
                                class="display rounded"
                                style="
                                    width: 100%;
                                    background-color: whitesmoke;
                                "
                            >
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Departman Adı</th>
                                        <th>Doktor Sayısı</th>
                                        <th class="text-center">Düzenle</th>
                                        <th class="text-center">Sil</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% list_department.forEach(department => {%>
                                    <tr>
                                        <td><%= department.id %></td>
                                        <td><%= department.name %></td>
                                        <td><%= department.number %></td>
                                        <td
                                            class="text-center"
                                            style="cursor: pointer"
                                        >
                                            <i
                                                class="fa-solid fa-pen-to-square text-success"
                                            ></i>
                                        </td>
                                        <td
                                            class="text-center"
                                            style="cursor: pointer"
                                        >
                                            <i
                                                class="fa-solid fa-trash text-danger"
                                            ></i>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-4 border rounded border-dark p-3 mx-1">
                        <a
                            href="<%= baseURL %>/doctor"
                            style="text-decoration: none; color: black"
                        >
                            <h5 class="text-center">
                                Doktorlarımızın Bilgileri
                            </h5>
                        </a>
                        <div>
                            <table
                                id="table_doctor"
                                class="display rounded"
                                style="
                                    width: 100%;
                                    background-color: whitesmoke;
                                "
                            >
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Ad</th>
                                        <th>Soyad</th>
                                        <th>Doktor Kayıt Tarihi</th>
                                        <th>Departman ID</th>
                                        <th>Departman Adı</th>
                                        <th>Departmana Kayıt Tarihi</th>
                                        <th class="text-center">Düzenle</th>
                                        <th class="text-center">Sil</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% list_doctor.forEach(doctor => { %>
                                    <tr>
                                        <td><%= doctor.doctor_id %></td>
                                        <td><%= doctor.doctor_name %></td>
                                        <td><%= doctor.doctor_surname %></td>
                                        <td>
                                            <%= new Intl.DateTimeFormat('tr-TR',
                                            { day: '2-digit', month: 'long',
                                            year: 'numeric' }).format(new
                                            Date(doctor.doctor_registration_date))
                                            %>
                                        </td>
                                        <td><%= doctor.department_id %></td>
                                        <td><%= doctor.department_name %></td>
                                        <td>
                                            <%= new Intl.DateTimeFormat('tr-TR',
                                            { day: '2-digit', month: 'long',
                                            year: 'numeric' }).format(new
                                            Date(doctor.department_doctor_registration_date))
                                            %>
                                        </td>
                                        <td
                                            class="text-center"
                                            style="cursor: pointer"
                                        >
                                            <i
                                                class="fa-solid fa-pen-to-square text-success"
                                            ></i>
                                        </td>
                                        <td
                                            class="text-center"
                                            style="cursor: pointer"
                                        >
                                            <i
                                                class="fa-solid fa-trash text-danger"
                                            ></i>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-4 border rounded border-dark p-3 mx-1">
                        <a
                            href="<%= baseURL %>/sick"
                            style="text-decoration: none; color: black"
                        >
                            <h5 class="text-center">
                                Hastalarımızın Bilgileri
                            </h5>
                        </a>
                        <div>
                            <table
                                id="table_sick"
                                class="display rounded"
                                style="
                                    width: 100%;
                                    background-color: whitesmoke;
                                "
                            >
                                <thead>
                                    <tr>
                                        <th>Muayene ID</th>
                                        <th>Hasta ID</th>
                                        <th>Hasta Ad</th>
                                        <th>Hasta Soyad</th>
                                        <th>Hasta Kayıt Tarihi</th>
                                        <th>Doktor ID</th>
                                        <th>Doktor Ad</th>
                                        <th>Doktor Soyad</th>
                                        <th>Hastanın Doktora Kayıt Tarihi</th>
                                        <th>Departman ID</th>
                                        <th>Departman Ad</th>
                                        <th class="text-center">Düzenle</th>
                                        <th class="text-center">Sil</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% list_sick.forEach(sick => { %>
                                    <tr>
                                        <td><%= sick.doctor_sick_id %></td>
                                        <td><%= sick.sick_id %></td>
                                        <td><%= sick.sick_name %></td>
                                        <td><%= sick.sick_surname %></td>
                                        <td>
                                            <%= new Intl.DateTimeFormat('tr-TR',
                                            { day: '2-digit', month: 'long',
                                            year: 'numeric' }).format(new
                                            Date(sick.sick_registration_date))
                                            %>
                                        </td>
                                        <td><%= sick.doctor_id %></td>
                                        <td><%= sick.doctor_name %></td>
                                        <td><%= sick.doctor_surname %></td>
                                        <td>
                                            <%= new Intl.DateTimeFormat('tr-TR',
                                            { day: '2-digit', month: 'long',
                                            year: 'numeric' }).format(new
                                            Date(sick.doctor_sick_registration_date))
                                            %>
                                        </td>
                                        <td><%= sick.department_id %></td>
                                        <td><%= sick.department_name %></td>
                                        <td
                                            class="text-center"
                                            style="cursor: pointer"
                                        >
                                            <i
                                                class="fa-solid fa-pen-to-square text-success"
                                            ></i>
                                        </td>
                                        <td
                                            class="text-center"
                                            style="cursor: pointer"
                                        >
                                            <i
                                                class="fa-solid fa-trash text-danger"
                                            ></i>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script
            src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
            integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
            crossorigin="anonymous"
        ></script>
        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"
            integrity="sha384-BBtl+eGJRgqQAUMxJ7pMwbEyER4l1g+O15P+16Ep7Q9Q+zqX6gSbd85u4mG4QzX+"
            crossorigin="anonymous"
        ></script>
        <script>
            new DataTable("#table_department", {
                paging: false,
                scrollCollapse: true,
                scrollY: "75vh",
                order: [
                    [2, "desc"],
                    [1, "asc"],
                ],
            });

            new DataTable("#table_doctor", {
                paging: false,
                scrollCollapse: true,
                scrollY: "75vh",
            });

            new DataTable("#table_sick", {
                paging: false,
                scrollCollapse: true,
                scrollY: "75vh",
            });
        </script>
    </body>
</html>
