<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <meta name="theme-name" content="quixlab" />
        <title><%= title %></title>
        <link rel="icon" type="image/x-icon" href="./img/favicon.ico" />
        <link
            href="theme/plugins/pg-calendar/css/pignose.calendar.min.css"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="theme/plugins/chartist/css/chartist.min.css"
        />
        <link
            rel="stylesheet"
            href="theme/plugins/chartist-plugin-tooltips/css/chartist-plugin-tooltip.css"
        />
        <link href="theme/css/style.css" rel="stylesheet" />
        <script
            type="text/javascript"
            src="https://www.gstatic.com/charts/loader.js"
        ></script>
        <script type="text/javascript">
            google.charts.load("current", { packages: ["corechart", "line"] });
            google.charts.setOnLoadCallback(drawBasic);

            function drawBasic() {
                fetch("http://localhost:3000/api/dailySickAmount")
                    .then((response) => {
                        if (!response.ok) {
                            throw new Error("Network response was not ok");
                        }
                        return response.json();
                    })
                    .then((data) => {
                        var chartData = new google.visualization.DataTable();
                        chartData.addColumn("string", "Günler");
                        chartData.addColumn("number", "Muayene Sayısı");
                        data.dailySickAmount.forEach((item) => {
                            chartData.addRow([
                                new Intl.DateTimeFormat("tr-TR", {
                                    day: "numeric",
                                    month: "short",
                                    year: "numeric",
                                }).format(
                                    new Date(item.sick_registration_date)
                                ),
                                item.number,
                            ]);
                        });
                        var options = {
                            title: "Günlük Muayene Sayıları (Son 14 Gün)",
                            titleTextStyle: {
                                fontSize: 24,
                                bold: true,
                            },
                            // curveType: "function",
                            // legend: { position: "bottom" },
                            hAxis: {
                                title: "Günler",
                                format: "M/d/yy",
                                slantedText: true,
                                slantedTextAngle: 90,
                            },
                            vAxis: {
                                title: "Muayene Sayısı",
                            },
                            chartArea: {
                                top: 75, // Üst padding
                                right: 200, // Sağ padding
                                bottom: 175, // Alt padding
                                left: 200, // Sol padding
                            },
                        };

                        var chart = new google.visualization.LineChart(
                            document.getElementById("chart_dailySickAmount")
                        );
                        chart.draw(chartData, options);
                    })
                    .catch((error) => {
                        console.error("Error fetching data:", error);
                        alert(
                            "Veri alınırken bir hata oluştu. Lütfen tekrar deneyin."
                        );
                    });
            }
        </script>

        <script type="text/javascript">
            google.charts.load("current", { packages: ["corechart"] });
            google.charts.setOnLoadCallback(fetchDataAndDrawChart);

            async function fetchDataAndDrawChart() {
                try {
                    const response = await fetch(
                        "http://localhost:3000/api/numberOfExaminationPerDoctor"
                    );
                    const result = await response.json();

                    const chartData = [
                        ["Departman", "Muayene Sayısı", { role: "style" }],
                    ];
                    result.numberOfExaminationPerDoctor.forEach((item) => {
                        const color = generateColor();
                        chartData.push([
                            item.department_name,
                            parseFloat(item.number_rate),
                            color,
                        ]);
                    });

                    const data =
                        google.visualization.arrayToDataTable(chartData);

                    const options = {
                        // title: "Departmanlarda Doktor Başına Düşen Muayene Sayısı",
                        hAxis: {
                            title: "Departman",
                            minValue: 0,
                            format: "decimal",
                        },
                        vAxis: {
                            title: "Muayene Sayısı",
                            format: "decimal",
                        },
                        legend: { position: "none" },
                        chartArea: {
                            top: 40, // Üst padding
                            bottom: 120, // Üst padding
                        },
                    };

                    const chart = new google.visualization.ColumnChart(
                        document.getElementById("chart_div")
                    );

                    chart.draw(data, options);
                } catch (error) {
                    console.error("Veri çekilirken hata oluştu:", error);
                }
            }

            // Rastgele renk oluşturma fonksiyonu
            function generateColor() {
                const letters = "0123456789ABCDEF";
                let color = "#";
                for (let i = 0; i < 6; i++) {
                    color += letters[Math.floor(Math.random() * 16)];
                }
                return color;
            }
        </script>
    </head>

    <body>
        <%- include('./_partials/_preloader.ejs') %>
        <div id="main-wrapper">
            <%- include('./_partials/_logo.ejs') %> <%-
            include('./_partials/_header.ejs') %> <%-
            include('./_partials/_sidebar.ejs') %>
            <div class="content-body">
                <div class="container-fluid mt-3">
                    <div class="row d-flex justify-content-center">
                        <div class="col-lg-3 col-sm-6">
                            <div class="card gradient-1">
                                <div
                                    class="card-body d-flex justify-content-around"
                                >
                                    <div>
                                        <span
                                            class="float-right display-5 opacity-1"
                                            ><i class="fa fa-h-square fa-lg"></i
                                        ></span>
                                    </div>
                                    <div class="text-center">
                                        <h3 class="card-title text-white">
                                            Departman
                                        </h3>
                                        <div class="d-inline-block">
                                            <h2 class="text-white">
                                                (<%= count_department[0].number
                                                %>)
                                            </h2>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6">
                            <div class="card gradient-1">
                                <div
                                    class="card-body d-flex justify-content-around"
                                >
                                    <div>
                                        <span
                                            class="float-right display-5 opacity-1"
                                            ><i class="fa fa-user-md fa-lg"></i
                                        ></span>
                                    </div>
                                    <div class="text-center">
                                        <h3 class="card-title text-white">
                                            Doktor
                                        </h3>
                                        <div class="d-inline-block">
                                            <h2 class="text-white">
                                                (<%= count_doctor[0].number %>)
                                            </h2>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6">
                            <div class="card gradient-1">
                                <div
                                    class="card-body d-flex justify-content-around"
                                >
                                    <div>
                                        <span
                                            class="float-right display-5 opacity-1"
                                            ><i class="fa fa-users fa-lg"></i
                                        ></span>
                                    </div>
                                    <div class="text-center">
                                        <h3 class="card-title text-white">
                                            Muayene
                                        </h3>
                                        <div class="d-inline-block">
                                            <h2 class="text-white">
                                                (<%= count_sick[0].number %>)
                                            </h2>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="card">
                                <div class="card-body">
                                    <div
                                        id="chart_dailySickAmount"
                                        style="min-width: 100%; height: 60vh"
                                    ></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <div class="card">
                                <div class="card-body">
                                    <h1
                                        class="text-center"
                                        style="font-size: 25px"
                                    >
                                        Departmanlarda Doktor Başına Düşen
                                        Muayene Sayısı
                                    </h1>
                                    <div
                                        id="chart_div"
                                        style="min-width: 100%; height: 60vh"
                                    ></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="footer gradient-1">
                <div
                    class="d-flex justify-content-center align-items-center pt-3 pb-2"
                >
                    <h3 class="mx-2 text-white" style="font-size: 20px">
                        Hastane KDS
                    </h3>
                    <h3 class="mx-2 text-white" style="font-size: 20px">|</h3>
                    <h3 class="mx-2 text-white" style="font-size: 20px">
                        2024
                    </h3>
                </div>
            </div>
        </div>
        <script src="theme/plugins/common/common.min.js"></script>
        <script src="theme/js/custom.min.js"></script>
        <script src="theme/js/settings.js"></script>
        <script src="theme/js/gleek.js"></script>
        <script src="theme/js/styleSwitcher.js"></script>
        <script src="theme/plugins/chart.js/Chart.bundle.min.js"></script>
        <script src="theme/plugins/circle-progress/circle-progress.min.js"></script>
        <script src="theme/plugins/d3v3/index.js"></script>
        <script src="theme/plugins/topojson/topojson.min.js"></script>
        <script src="theme/plugins/datamaps/datamaps.world.min.js"></script>
        <script src="theme/plugins/raphael/raphael.min.js"></script>
        <script src="theme/plugins/morris/morris.min.js"></script>
        <script src="theme/plugins/moment/moment.min.js"></script>
        <script src="theme/plugins/pg-calendar/js/pignose.calendar.min.js"></script>
        <script src="theme/plugins/chartist/js/chartist.min.js"></script>
        <script src="theme/plugins/chartist-plugin-tooltips/js/chartist-plugin-tooltip.min.js"></script>
        <script src="theme/js/dashboard/dashboard-1.js"></script>
    </body>
</html>
