<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <meta name="theme-name" content="quixlab" />
        <title><%= title %></title>
        <link rel="icon" type="image/x-icon" href="./img/favicon.ico" />
        <link
            href="theme/plugins/pg-calendar/css/pignose.calendar.min.css"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="theme/plugins/chartist/css/chartist.min.css"
        />
        <link
            rel="stylesheet"
            href="theme/plugins/chartist-plugin-tooltips/css/chartist-plugin-tooltip.css"
        />
        <link href="theme/css/style.css" rel="stylesheet" />
        <link
            rel="stylesheet"
            href="https://cdn.datatables.net/2.1.8/css/dataTables.dataTables.css"
        />
        <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
        <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
        <script
            type="text/javascript"
            src="https://www.gstatic.com/charts/loader.js"
        ></script>
        <script type="text/javascript">
            google.charts.load("current", { packages: ["corechart"] });
            google.charts.setOnLoadCallback(drawVisualization);

            function drawVisualization() {
                fetch(
                    "http://localhost:3000/api/monthlyNumberOfSickByDepartment"
                )
                    .then((response) => {
                        if (!response.ok) {
                            throw new Error("Network response was not ok");
                        }
                        return response.json();
                    })
                    .then((data) => {
                        const formattedData = {};
                        data.monthlyNumberOfSickByDepartment.forEach((item) => {
                            const {
                                department_name,
                                sick_registration_date,
                                number,
                            } = item;

                            if (!formattedData[sick_registration_date]) {
                                formattedData[sick_registration_date] = {
                                    date: new Intl.DateTimeFormat("tr-TR", {
                                        month: "short",
                                        year: "numeric",
                                    }).format(new Date(sick_registration_date)),
                                };
                            }
                            formattedData[sick_registration_date][
                                department_name
                            ] = number;
                        });

                        const departments = [
                            ...new Set(
                                data.monthlyNumberOfSickByDepartment.map(
                                    (item) => item.department_name
                                )
                            ),
                        ];
                        const chartDataArray = [["Tarih", ...departments]];

                        Object.values(formattedData).forEach((row) => {
                            const rowArray = [row.date];
                            departments.forEach((department) => {
                                rowArray.push(row[department] || 0);
                            });
                            chartDataArray.push(rowArray);
                        });

                        const chartData =
                            google.visualization.arrayToDataTable(
                                chartDataArray
                            );

                        const options = {
                            title: "Departmanların Aylık Muayene Sayıları",
                            titleTextStyle: {
                                fontSize: 24,
                                bold: true,
                            },
                            vAxis: { title: "Muayene Sayısı" },
                            hAxis: {
                                title: "Tarih",
                                format: "d/yy",
                                // slantedText: true,
                                // slantedTextAngle: 90,
                            },
                            seriesType: "bars",
                            series: { [departments.length]: { type: "line" } },
                            chartArea: {
                                top: 75,
                                right: 300,
                                bottom: 175,
                                left: 150,
                            },
                        };

                        const chart = new google.visualization.ComboChart(
                            document.getElementById("chart_div")
                        );
                        chart.draw(chartData, options);
                    })
                    .catch((error) => {
                        console.error("Error fetching data:", error);
                        alert(
                            "Veri alınırken bir hata oluştu. Lütfen tekrar deneyin."
                        );
                    });
            }
        </script>
    </head>

    <body>
        <%- include('../_partials/_preloader.ejs') %>
        <div id="main-wrapper">
            <%- include('../_partials/_logo.ejs') %> <%-
            include('../_partials/_header.ejs') %> <%-
            include('../_partials/_sidebar.ejs') %>
            <div class="content-body">
                <div class="container-fluid mt-3">
                    <div class="row">
                        <div class="col-12 col-lg-12">
                            <div class="card">
                                <div class="card-body">
                                    <div
                                        id="chart_div"
                                        style="min-width: 100%; height: 500px"
                                    ></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row d-flex">
                        <div class="col-12 col-lg-6">
                            <div class="card">
                                <div class="card-body">
                                    <h1
                                        class="text-center"
                                        style="font-size: 24px"
                                    >
                                        Departmanlardaki Doktor Sayıları
                                    </h1>
                                    <div>
                                        <table
                                            id="table_departmentDoctor"
                                            class="display rounded"
                                            style="
                                                width: 100%;
                                                background-color: whitesmoke;
                                            "
                                        >
                                            <thead>
                                                <tr>
                                                    <th class="text-center">
                                                        ID
                                                    </th>
                                                    <th>Departman Adı</th>
                                                    <th class="text-center">
                                                        Doktor Sayısı
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- prettier-ignore -->
                                                <% list_numberOfDoctorInDepartment.forEach(item => { %>
                                                <!-- prettier-ignore -->
                                                <tr>
                                                    <td class="text-center">
                                                        <%= item.department_id %>
                                                    </td>
                                                    <td>
                                                        <%= item.department_name %>
                                                    </td>
                                                    <td class="text-center">
                                                        <%= item.number %>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6">
                            <div class="card">
                                <div class="card-body">
                                    <h5
                                        class="text-center"
                                        style="font-size: 24px"
                                    >
                                        Departmanların Toplam Muayene Sayıları
                                    </h5>
                                    <div>
                                        <table
                                            id="table_department"
                                            class="display rounded"
                                            style="
                                                width: 100%;
                                                background-color: whitesmoke;
                                            "
                                        >
                                            <thead>
                                                <tr>
                                                    <th class="text-center">
                                                        ID
                                                    </th>
                                                    <th>Departman Adı</th>
                                                    <th class="text-center">
                                                        Muayene Sayısı
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- prettier-ignore -->
                                                <% list_numberOfSickByDepartment.forEach(item => { %>
                                                <!-- prettier-ignore -->
                                                <tr>
                                                    <td class="text-center">
                                                        <%= item.department_id %>
                                                    </td>
                                                    <td><%= item.department_name %></td>
                                                    <td class="text-center">
                                                        <%= item.number %>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script src="theme/plugins/common/common.min.js"></script>
        <script src="theme/js/custom.min.js"></script>
        <script src="theme/js/settings.js"></script>
        <script src="theme/js/gleek.js"></script>
        <script src="theme/js/styleSwitcher.js"></script>
        <script src="theme/plugins/chart.js/Chart.bundle.min.js"></script>
        <script src="theme/plugins/circle-progress/circle-progress.min.js"></script>
        <script src="theme/plugins/d3v3/index.js"></script>
        <script src="theme/plugins/topojson/topojson.min.js"></script>
        <script src="theme/plugins/datamaps/datamaps.world.min.js"></script>
        <script src="theme/plugins/raphael/raphael.min.js"></script>
        <script src="theme/plugins/morris/morris.min.js"></script>
        <script src="theme/plugins/moment/moment.min.js"></script>
        <script src="theme/plugins/pg-calendar/js/pignose.calendar.min.js"></script>
        <script src="theme/plugins/chartist/js/chartist.min.js"></script>
        <script src="theme/plugins/chartist-plugin-tooltips/js/chartist-plugin-tooltip.min.js"></script>
        <script src="theme/js/dashboard/dashboard-1.js"></script>
        <script>
            new DataTable("#table_departmentDoctor", {
                paging: false,
                scrollCollapse: true,
                scrollY: "30vh",
                order: [[2, "desc"]],
            });

            new DataTable("#table_department", {
                paging: false,
                scrollCollapse: true,
                scrollY: "30vh",
                order: [[2, "desc"]],
            });
        </script>
    </body>
</html>
