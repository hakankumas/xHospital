<% const baseURL = "http://localhost:3000"; %>

<!DOCTYPE html>
<html lang="en">
    <head>
        <title><%= title %></title>
        <link rel="icon" type="image/x-icon" href="./img/favicon.ico" />
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, shrink-to-fit=no"
        />
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
            crossorigin="anonymous"
        />
        <link rel="stylesheet" href="/css/style.css" />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css"
            integrity="sha512-5Hs3dF2AEPkpNAR7UiOHba+lRSJNeM2ECkwxUIxC1Q/FLycGTbNapWXB4tP889k5T5Ju8fs4b1P5z/iB4nMfSQ=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"
        />
        <link
            rel="stylesheet"
            href="https://cdn.datatables.net/2.1.8/css/dataTables.dataTables.css"
        />
        <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
        <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
        <script
            type="text/javascript"
            src="https://www.gstatic.com/charts/loader.js"
        ></script>
        <script type="text/javascript">
            google.charts.load("current", { packages: ["corechart"] });
            google.charts.setOnLoadCallback(drawVisualization);

            function drawVisualization() {
                fetch("http://localhost:3000/api/dailyNumberOfSickByDepartment")
                    .then((response) => {
                        if (!response.ok) {
                            throw new Error("Network response was not ok");
                        }
                        return response.json();
                    })
                    .then((data) => {
                        const formattedData = {};
                        data.dailyNumberOfSickByDepartment.forEach((item) => {
                            const {
                                department_name,
                                sick_registration_date,
                                number,
                            } = item;

                            if (!formattedData[sick_registration_date]) {
                                formattedData[sick_registration_date] = {
                                    date: new Intl.DateTimeFormat("tr-TR", {
                                        day: "numeric",
                                        month: "short",
                                        year: "numeric",
                                    }).format(new Date(sick_registration_date)),
                                };
                            }
                            formattedData[sick_registration_date][
                                department_name
                            ] = number;
                        });

                        // Tüm departmanları bul ve sütun başlıklarını oluştur
                        const departments = [
                            ...new Set(
                                data.dailyNumberOfSickByDepartment.map(
                                    (item) => item.department_name
                                )
                            ),
                        ];
                        const chartDataArray = [["Tarih", ...departments]];

                        // Veriyi tabloya dönüştür
                        Object.values(formattedData).forEach((row) => {
                            const rowArray = [row.date];
                            departments.forEach((department) => {
                                rowArray.push(row[department] || 0); // Eksik veriler için 0 ekle
                            });
                            chartDataArray.push(rowArray);
                        });

                        // Veriyi Google Charts için formatla
                        const chartData =
                            google.visualization.arrayToDataTable(
                                chartDataArray
                            );

                        // Grafik seçeneklerini tanımla
                        const options = {
                            title: "Departmanların Günlük Muayene Sayıları",
                            titleTextStyle: {
                                fontSize: 24,
                                bold: true,
                            },
                            vAxis: { title: "Muayene Sayısı" },
                            hAxis: {
                                title: "Tarih",
                                format: "M/d/yy",
                                slantedText: true,
                                slantedTextAngle: 90,
                            },
                            seriesType: "bars",
                            series: { [departments.length]: { type: "line" } },
                            chartArea: {
                                top: 75, // Üst padding
                                right: 200, // Sağ padding
                                bottom: 175, // Alt padding
                                left: 200, // Sol padding
                            },
                        };

                        // Grafiği çiz
                        const chart = new google.visualization.ComboChart(
                            document.getElementById("chart_div")
                        );
                        chart.draw(chartData, options);
                    })
                    .catch((error) => {
                        console.error("Error fetching data:", error);
                        alert(
                            "Veri alınırken bir hata oluştu. Lütfen tekrar deneyin."
                        );
                    });
            }
        </script>
    </head>
    <body>
        <%- include('../_partials/_navbar') %>
        <div class="container-fluid px-5">
            <div
                class="row bg-success-subtle"
                style="min-height: 100vh; height: 100%"
            >
                <div class="col-md-12 py-3 px-4 d-flex flex-wrap">
                    <div class="col-md-12 p-3">
                        <div
                            id="chart_div"
                            style="min-width: 100%; height: 500px"
                        ></div>
                    </div>
                    <div class="col-md-6 py-3 px-5 hover_box">
                        <h5 class="text-center">
                            Departmanlardaki Doktor Sayıları
                        </h5>
                        <div>
                            <table
                                id="table_departmentDoctor"
                                class="display rounded"
                                style="
                                    width: 100%;
                                    background-color: whitesmoke;
                                "
                            >
                                <thead>
                                    <tr>
                                        <th class="text-center">ID</th>
                                        <th>Departman Adı</th>
                                        <th class="text-center">
                                            Doktor Sayısı
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- prettier-ignore -->
                                    <% list_numberOfDoctorInDepartment.forEach(item => { %>
                                    <!-- prettier-ignore -->
                                    <tr>
                                        <td class="text-center">
                                            <%= item.department_id %>
                                        </td>
                                        <td>
                                            <%= item.department_name %>
                                        </td>
                                        <td class="text-center">
                                            <%= item.number %>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-6 py-3 px-5 hover_box">
                        <h5 class="text-center">
                            Departmanların Muayene Sayıları
                        </h5>
                        <div>
                            <table
                                id="table_department"
                                class="display rounded"
                                style="
                                    width: 100%;
                                    background-color: whitesmoke;
                                "
                            >
                                <thead>
                                    <tr>
                                        <th class="text-center">ID</th>
                                        <th>Departman Adı</th>
                                        <th class="text-center">
                                            Muayene Sayısı
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- prettier-ignore -->
                                    <% list_numberOfSickByDepartment.forEach(item => { %>
                                    <!-- prettier-ignore -->
                                    <tr>
                                        <td class="text-center">
                                            <%= item.department_id %>
                                        </td>
                                        <td><%= item.department_name %></td>
                                        <td class="text-center">
                                            <%= item.number %>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="col-md-6 p-3 hover_box">1</div>
                    <div class="col-md-6 p-3 hover_box">2</div>
                </div>
            </div>
        </div>
        <script
            src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
            integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
            crossorigin="anonymous"
        ></script>
        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.min.js"
            integrity="sha384-BBtl+eGJRgqQAUMxJ7pMwbEyER4l1g+O15P+16Ep7Q9Q+zqX6gSbd85u4mG4QzX+"
            crossorigin="anonymous"
        ></script>
        <script>
            new DataTable("#table_departmentDoctor", {
                paging: false,
                scrollCollapse: true,
                scrollY: "30vh",
                order: [[2, "desc"]],
            });

            new DataTable("#table_department", {
                paging: false,
                scrollCollapse: true,
                scrollY: "30vh",
                order: [[2, "desc"]],
            });
        </script>
    </body>
</html>
