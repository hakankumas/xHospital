<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <meta name="theme-name" content="quixlab" />
        <title><%= title %></title>
        <link rel="icon" type="image/x-icon" href="./img/favicon.ico" />
        <link
            href="theme/plugins/pg-calendar/css/pignose.calendar.min.css"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="theme/plugins/chartist/css/chartist.min.css"
        />
        <link
            rel="stylesheet"
            href="theme/plugins/chartist-plugin-tooltips/css/chartist-plugin-tooltip.css"
        />
        <link href="theme/css/style.css" rel="stylesheet" />
        <link
            rel="stylesheet"
            href="https://cdn.datatables.net/2.1.8/css/dataTables.dataTables.css"
        />
        <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
        <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
        <script
            type="text/javascript"
            src="https://www.gstatic.com/charts/loader.js"
        ></script>
        <script type="text/javascript">
            google.charts.load("current", { packages: ["corechart"] });
            google.charts.setOnLoadCallback(drawVisualization);
            google.charts.setOnLoadCallback(drawChart);

            function drawVisualization() {
                fetch("http://localhost:3000/api/dailyNumberOfSickByDoctor")
                    .then((response) => {
                        if (!response.ok) {
                            throw new Error("Network response was not ok");
                        }
                        return response.json();
                    })
                    .then((data) => {
                        const formattedData = {};
                        data.dailyNumberOfSickByDoctor.forEach((item) => {
                            const {
                                doctor_fullname,
                                sick_registration_date,
                                number,
                            } = item;

                            if (!formattedData[sick_registration_date]) {
                                formattedData[sick_registration_date] = {
                                    date: new Intl.DateTimeFormat("tr-TR", {
                                        day: "numeric",
                                        month: "short",
                                        year: "numeric",
                                    }).format(new Date(sick_registration_date)),
                                };
                            }
                            formattedData[sick_registration_date][
                                doctor_fullname
                            ] = number;
                        });

                        // Tüm departmanları bul ve sütun başlıklarını oluştur
                        const doctors = [
                            ...new Set(
                                data.dailyNumberOfSickByDoctor.map(
                                    (item) => item.doctor_fullname
                                )
                            ),
                        ];
                        const chartDataArray = [["Tarih", ...doctors]];

                        // Veriyi tabloya dönüştür
                        Object.values(formattedData).forEach((row) => {
                            const rowArray = [row.date];
                            doctors.forEach((doctor) => {
                                rowArray.push(row[doctor] || 0); // Eksik veriler için 0 ekle
                            });
                            chartDataArray.push(rowArray);
                        });

                        // Veriyi Google Charts için formatla
                        const chartData =
                            google.visualization.arrayToDataTable(
                                chartDataArray
                            );

                        // Grafik seçeneklerini tanımla
                        const options = {
                            title: "Doktorların Günlük Muayene Sayıları (Son 14 Gün)",
                            titleTextStyle: {
                                fontSize: 24,
                                bold: true,
                            },
                            vAxis: { title: "Muayene Sayısı" },
                            hAxis: {
                                title: "Tarih",
                                format: "M/d/yy",
                                slantedText: true,
                                slantedTextAngle: 90,
                            },
                            seriesType: "bars",
                            series: { [doctors.length]: { type: "line" } },
                            chartArea: {
                                top: 75, // Üst padding
                                right: 300, // Sağ padding
                                bottom: 175, // Alt padding
                                left: 150, // Sol padding
                            },
                        };

                        // Grafiği çiz
                        const chart = new google.visualization.ComboChart(
                            document.getElementById("chart_div")
                        );
                        chart.draw(chartData, options);
                    })
                    .catch((error) => {
                        console.error("Error fetching data:", error);
                        alert(
                            "Veri alınırken bir hata oluştu. Lütfen tekrar deneyin."
                        );
                    });
            }

            function drawChart() {
                fetch("http://localhost:3000/api/genderByDoctor")
                    .then((response) => response.json())
                    .then((data) => {
                        const chartData = [["Cinsiyet", "Yüzde"]]; // Başlık ekleniyor

                        // API'den dönen verileri formatlayarak chartData'ya ekliyoruz
                        data.genderByDoctor.forEach((item) => {
                            chartData.push([item.gender_name, item.number]);
                        });

                        // Google Charts veri formatına dönüştürülüyor
                        const dataTable =
                            google.visualization.arrayToDataTable(chartData);

                        const options = {
                            title: "Doktorların Cinsiyet Dağılımı",
                            titleTextStyle: {
                                fontSize: 18,
                                bold: true,
                            },
                            chartArea: {
                                top: 85, // Üst padding
                            },
                        };

                        const chart = new google.visualization.PieChart(
                            document.getElementById("piechart")
                        );

                        chart.draw(dataTable, options);
                    })
                    .catch((error) => {
                        console.error(
                            "API çağrısı sırasında bir hata oluştu:",
                            error
                        );
                    });
            }
        </script>
    </head>

    <body>
        <%- include('../_partials/_preloader.ejs') %>
        <div id="main-wrapper">
            <%- include('../_partials/_logo.ejs') %> <%-
            include('../_partials/_header.ejs') %> <%-
            include('../_partials/_sidebar.ejs') %>
            <div class="content-body">
                <div class="container-fluid mt-3">
                    <div class="row">
                        <div class="col-12 col-lg-12">
                            <div class="card">
                                <div class="card-body">
                                    <div
                                        id="chart_div"
                                        style="min-width: 100%; height: 500px"
                                    ></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row d-flex">
                        <div class="col-12 col-lg-6">
                            <div class="card">
                                <div class="card-body">
                                    <h1
                                        class="text-center"
                                        style="font-size: 24px"
                                    >
                                        Doktorların Toplam Muayene Sayıları
                                    </h1>
                                    <div>
                                        <table
                                            id="table_doctor"
                                            class="display rounded"
                                            style="
                                                width: 100%;
                                                background-color: whitesmoke;
                                            "
                                        >
                                            <thead>
                                                <tr>
                                                    <th class="text-center">
                                                        ID
                                                    </th>
                                                    <th>Doktor Adı</th>
                                                    <th>Doktor Soyadı</th>
                                                    <th>Cinsiyet</th>
                                                    <th>Departman Adı</th>
                                                    <th class="text-center">
                                                        Muayene Sayısı
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- prettier-ignore -->
                                                <% list_sumNumberOfSickByDoctor.forEach(item => { %>
                                                <!-- prettier-ignore -->
                                                <tr>
                                                    <td class="text-center">
                                                        <%= item.doctor_id %>
                                                    </td>
                                                    <td><%= item.doctor_name %></td>
                                                    <td><%= item.doctor_surname %></td>
                                                    <td><%= item.gender_name %></td>
                                                    <td><%= item.department_name %></td>
                                                    <td class="text-center">
                                                        <%= item.number %>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6">
                            <div class="card">
                                <div class="card-body">
                                    <div
                                        id="piechart"
                                        style="min-width: 100%; height: 300px"
                                    ></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script src="theme/plugins/common/common.min.js"></script>
        <script src="theme/js/custom.min.js"></script>
        <script src="theme/js/settings.js"></script>
        <script src="theme/js/gleek.js"></script>
        <script src="theme/js/styleSwitcher.js"></script>
        <script src="theme/plugins/chart.js/Chart.bundle.min.js"></script>
        <script src="theme/plugins/circle-progress/circle-progress.min.js"></script>
        <script src="theme/plugins/d3v3/index.js"></script>
        <script src="theme/plugins/topojson/topojson.min.js"></script>
        <script src="theme/plugins/datamaps/datamaps.world.min.js"></script>
        <script src="theme/plugins/raphael/raphael.min.js"></script>
        <script src="theme/plugins/morris/morris.min.js"></script>
        <script src="theme/plugins/moment/moment.min.js"></script>
        <script src="theme/plugins/pg-calendar/js/pignose.calendar.min.js"></script>
        <script src="theme/plugins/chartist/js/chartist.min.js"></script>
        <script src="theme/plugins/chartist-plugin-tooltips/js/chartist-plugin-tooltip.min.js"></script>
        <script src="theme/js/dashboard/dashboard-1.js"></script>
        <script>
            new DataTable("#table_doctor", {
                paging: false,
                scrollCollapse: true,
                scrollY: "75vh",
                order: [[5, "desc"]],
            });
        </script>
    </body>
</html>
